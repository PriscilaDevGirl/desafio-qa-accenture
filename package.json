{
  "name": "desafio-qa-accenture",
  "version": "1.0.0",
  "private": true,
  "description": "Automação DemoQA de API e interface com Selenium e Cucumber",
  "scripts": {
    "test": "cucumber-js",
    "test:api": "cucumber-js --profile api",
    "test:ui": "cucumber-js --profile frontend",
    "test:frontend": "cucumber-js --profile frontend",
    "test:bonus": "cucumber-js --profile frontend --tags @bonus",
    "evidencias": "node scripts/generate-evidence.js",
    "test:dry": "cucumber-js --dry-run",
    "check": "node scripts/check.js"
  },
  "engines": { "node": ">=22" },
  "devDependencies": {
    "@cucumber/cucumber": "^12.0.0",
    "selenium-webdriver": "^4.35.0"
  }
}
