              "if (!pm.collectionVariables.get('qaToken')) { pm.execution.setNextRequest(null); pm.execution.skipRequest(); throw new Error('Execute as etapas anteriores: variável qaToken ausente.'); }",
              "if (!pm.collectionVariables.get('qaIsbn1')) { pm.execution.setNextRequest(null); pm.execution.skipRequest(); throw new Error('Execute as etapas anteriores: variável qaIsbn1 ausente.'); }",
              "if (!pm.collectionVariables.get('qaIsbn2')) { pm.execution.setNextRequest(null); pm.execution.skipRequest(); throw new Error('Execute as etapas anteriores: variável qaIsbn2 ausente.'); }"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "(function () {",
              "let checksPassed = true;",
              "function check(name, assertion) {",
              "  pm.test(name, function () {",
              "    try { assertion(); } catch (error) { checksPassed = false; throw error; }",
              "  });",
              "}",
              "check('HTTP 200', () => pm.response.to.have.status(200));",
              "let data;",
              "check('Resposta em JSON', () => { data = pm.response.json(); });",
              "if (checksPassed) {",
              "check('Identificador corresponde ao usuário criado', () => pm.expect(data.userId).to.eql(pm.collectionVariables.get('qaUserId')));",
              "check('Nome corresponde ao usuário criado', () => pm.expect(data.username).to.eql(pm.collectionVariables.get('qaUsername')));",
              "check('Usuário tem exatamente os dois livros reservados', () => {",
              "  pm.expect(data.books).to.be.an('array').with.lengthOf(2);",
              "  const expected = [pm.collectionVariables.get('qaIsbn1'), pm.collectionVariables.get('qaIsbn2')].sort();",
              "  pm.expect(data.books.map(book => book.isbn).sort()).to.eql(expected);",
              "});",
