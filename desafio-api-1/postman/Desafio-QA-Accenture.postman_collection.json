    {
      "id": "bbfef103-13e6-4e72-a1b6-6f8aeaa85104",
      "name": "04 — Listar livros e selecionar dois ISBNs",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "(function () {",
              "let checksPassed = true;",
              "function check(name, assertion) {",
              "  pm.test(name, function () {",
              "    try { assertion(); } catch (error) { checksPassed = false; throw error; }",
              "  });",
              "}",
              "check('HTTP 200', () => pm.response.to.have.status(200));",
              "let data;",
              "check('Resposta em JSON', () => { data = pm.response.json(); });",
              "if (checksPassed) {",
              "check('Catálogo é uma lista', () => pm.expect(data.books).to.be.an('array'));",
              "if (checksPassed) {",
              "  const isbns = [...new Set(data.books.map(book => book.isbn).filter(isbn => typeof isbn === 'string' && isbn.length > 0))];",
              "  check('Há pelo menos dois ISBNs diferentes', () => pm.expect(isbns.length).to.be.at.least(2));",
              "  if (checksPassed) {",
              "    pm.collectionVariables.set('qaIsbn1', isbns[0]);",
              "    pm.collectionVariables.set('qaIsbn2', isbns[1]);",
              "  }",
              "}",
              "}",
              "",
              "if (!checksPassed) pm.execution.setNextRequest(null);",
              "})();"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "auth": {
          "type": "noauth"
        },
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/BookStore/v1/Books",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "BookStore",
            "v1",
            "Books"
          ]
        },
        "description": "Seleciona automaticamente os dois primeiros ISBNs distintos do catálogo, sem fixar dados de livros no arquivo."
      },
      "response": []
    },
    {
      "id": "bbfef103-13e6-4e72-a1b6-6f8aeaa85105",
      "name": "05 — Reservar dois livros",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (!pm.collectionVariables.get('qaUserId')) { pm.execution.setNextRequest(null); pm.execution.skipRequest(); throw new Error('Execute as etapas anteriores: variável qaUserId ausente.'); }",
              "if (!pm.collectionVariables.get('qaToken')) { pm.execution.setNextRequest(null); pm.execution.skipRequest(); throw new Error('Execute as etapas anteriores: variável qaToken ausente.'); }",
              "if (!pm.collectionVariables.get('qaIsbn1')) { pm.execution.setNextRequest(null); pm.execution.skipRequest(); throw new Error('Execute as etapas anteriores: variável qaIsbn1 ausente.'); }",
              "if (!pm.collectionVariables.get('qaIsbn2')) { pm.execution.setNextRequest(null); pm.execution.skipRequest(); throw new Error('Execute as etapas anteriores: variável qaIsbn2 ausente.'); }"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "(function () {",
              "let checksPassed = true;",
              "function check(name, assertion) {",
              "  pm.test(name, function () {",
              "    try { assertion(); } catch (error) { checksPassed = false; throw error; }",
              "  });",
              "}",
              "check('HTTP 201', () => pm.response.to.have.status(201));",
              "let data;",
              "check('Resposta em JSON', () => { data = pm.response.json(); });",
              "if (checksPassed) {",
              "check('Reserva contém exatamente os dois ISBNs selecionados', () => {",
              "  pm.expect(data.books).to.be.an('array').with.lengthOf(2);",
              "  const expected = [pm.collectionVariables.get('qaIsbn1'), pm.collectionVariables.get('qaIsbn2')].sort();",
              "  pm.expect(data.books.map(book => book.isbn).sort()).to.eql(expected);",
              "});",
              "}",
              "",
              "if (!checksPassed) pm.execution.setNextRequest(null);",
              "})();"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "auth": {
          "type": "bearer",
          "bearer": [
