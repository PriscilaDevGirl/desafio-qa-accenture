    {
      "id": "bbfef103-13e6-4e72-a1b6-6f8aeaa85107",
      "name": "07 — Limpeza: excluir usuário de teste",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (!pm.collectionVariables.get('qaUserId')) { pm.execution.setNextRequest(null); pm.execution.skipRequest(); throw new Error('Execute as etapas anteriores: variável qaUserId ausente.'); }",
              "if (!pm.collectionVariables.get('qaToken')) { pm.execution.setNextRequest(null); pm.execution.skipRequest(); throw new Error('Execute as etapas anteriores: variável qaToken ausente.'); }"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "(function () {",
              "let checksPassed = true;",
              "function check(name, assertion) {",
              "  pm.test(name, function () {",
              "    try { assertion(); } catch (error) { checksPassed = false; throw error; }",
              "  });",
              "}",
              "check('HTTP 204', () => pm.response.to.have.status(204));",
              "if (checksPassed) {",
              "check('Exclusão não retorna corpo', () => pm.expect(pm.response.text()).to.eql(''));",
              "if (checksPassed) {",
              "  for (const key of ['qaUsername', 'qaPassword', 'qaUserId', 'qaToken', 'qaIsbn1', 'qaIsbn2']) pm.collectionVariables.unset(key);",
              "}",
              "}",
              "",
              "if (!checksPassed) pm.execution.setNextRequest(null);",
              "})();"
            ]
          }
        }
      ],
      "request": {
        "method": "DELETE",
