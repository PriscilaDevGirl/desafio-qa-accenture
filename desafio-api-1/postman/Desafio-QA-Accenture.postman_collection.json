  "item": [
    {
      "id": "bbfef103-13e6-4e72-a1b6-6f8aeaa85101",
      "name": "01 — Criar usuário exclusivo",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "for (const key of ['qaUsername', 'qaPassword', 'qaUserId', 'qaToken', 'qaIsbn1', 'qaIsbn2']) pm.collectionVariables.unset(key);",
              "const uniqueId = pm.variables.replaceIn('{{$guid}}');",
              "pm.collectionVariables.set('qaUsername', 'qa_' + uniqueId);",
              "pm.collectionVariables.set('qaPassword', 'Qa!9aA' + uniqueId);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "(function () {",
              "let checksPassed = true;",
              "function check(name, assertion) {",
              "  pm.test(name, function () {",
              "    try { assertion(); } catch (error) { checksPassed = false; throw error; }",
              "  });",
              "}",
              "check('HTTP 201', () => pm.response.to.have.status(201));",
              "let data;",
              "check('Resposta em JSON', () => { data = pm.response.json(); });",
              "if (checksPassed) {",
              "check('Identificador do usuário preenchido', () => pm.expect(data.userID).to.be.a('string').and.not.empty);",
              "check('Nome do usuário corresponde ao enviado', () => pm.expect(data.username).to.eql(pm.collectionVariables.get('qaUsername')));",
              "check('Usuário começa sem livros', () => pm.expect(data.books).to.eql([]));",
              "if (checksPassed) pm.collectionVariables.set('qaUserId', data.userID);",
              "}",
              "",
              "if (!checksPassed) pm.execution.setNextRequest(null);",
              "})();"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "auth": {
          "type": "noauth"
        },
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"userName\": \"{{qaUsername}}\",\n  \"password\": \"{{qaPassword}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/Account/v1/User",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "Account",
            "v1",
            "User"
          ]
        },
        "description": "Gera nome e senha válidos a cada execução e salva o userID retornado pela API."
      },
      "response": []
    },
    {
      "id": "bbfef103-13e6-4e72-a1b6-6f8aeaa85102",
      "name": "02 — Gerar token de acesso",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (!pm.collectionVariables.get('qaUsername')) { pm.execution.setNextRequest(null); pm.execution.skipRequest(); throw new Error('Execute as etapas anteriores: variável qaUsername ausente.'); }",
              "if (!pm.collectionVariables.get('qaPassword')) { pm.execution.setNextRequest(null); pm.execution.skipRequest(); throw new Error('Execute as etapas anteriores: variável qaPassword ausente.'); }",
              "if (!pm.collectionVariables.get('qaUserId')) { pm.execution.setNextRequest(null); pm.execution.skipRequest(); throw new Error('Execute as etapas anteriores: variável qaUserId ausente.'); }"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "(function () {",
              "let checksPassed = true;",
              "function check(name, assertion) {",
              "  pm.test(name, function () {",
              "    try { assertion(); } catch (error) { checksPassed = false; throw error; }",
              "  });",
              "}",
              "check('HTTP 200', () => pm.response.to.have.status(200));",
              "let data;",
              "check('Resposta em JSON', () => { data = pm.response.json(); });",
              "if (checksPassed) {",
              "check('Token gerado com sucesso', () => pm.expect(data.status).to.eql('Success'));",
              "check('Token preenchido', () => pm.expect(data.token).to.be.a('string').and.not.empty);",
              "check('Token possui expiração futura', () => pm.expect(Date.parse(data.expires)).to.be.above(Date.now()));",
              "if (checksPassed) pm.collectionVariables.set('qaToken', data.token);",
              "}",
              "",
              "if (!checksPassed) pm.execution.setNextRequest(null);",
              "})();"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "auth": {
          "type": "noauth"
        },
        "header": [
